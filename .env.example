# Google Cloud OAuth 2.0 web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000

# Cloudflare Turnstile for the report form. Put these in .dev.vars for local work.
# The real site key lives in wrangler.jsonc and only works on the deployed hostname.
# Test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# Test secret that always fails: 2x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
